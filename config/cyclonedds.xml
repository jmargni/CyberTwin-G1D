<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces><NetworkInterface autodetermine="true" priority="default" multicast="default" /></Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
    <Discovery><ParticipantIndex>auto</ParticipantIndex><MaxAutoParticipantIndex>120</MaxAutoParticipantIndex></Discovery>
    <Tracing><Verbosity>warning</Verbosity><OutputFile>/evidence/cyclonedds.log</OutputFile></Tracing>
  </Domain>
</CycloneDDS>
